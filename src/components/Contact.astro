---
import SocialPill from "./SocialPill.astro"
import LinkedInIcon from '../icons/LinkedIn.astro'
import GithubIcon from '../icons/Github.astro'
import MailIcon from '../icons/Mail.astro'
---

<nav class={`
${Astro.props.class}
    flex 
    flex-row 
    flex-wrap
    justify-center 
    gap-4
    `}>
        <SocialPill href="https://linkedin.com/in/cortesa74">
          <LinkedInIcon class="size-6" aria-hidden="true"/>
          LinkedIn
        </SocialPill>
        <SocialPill href="https://github.com/cortesa">
          <GithubIcon class="size-6" aria-hidden="true"/>
          Github
        </SocialPill>
        <SocialPill href="mailto:cortesa@gmail.com">
          <MailIcon class="size-6" aria-hidden="true"/>
          cortesa@gmail.com
        </SocialPill>
    </nav>
